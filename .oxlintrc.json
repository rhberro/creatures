{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "restriction": "error",
    // "style": "error",
    "suspicious": "error"
  },
  "globals": {
    "document": "readonly"
  },
  "ignorePatterns": ["*.d.ts"],
  "jsPlugins": ["./tools/oxlint-plugins"],
  "overrides": [
    {
      "files": ["**/*.{ts,tsx,jsx}"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/jsx-filename-extension": "off",
        "react/jsx-no-literals": "off"
      }
    },
    {
      "files": ["**/*.{ts,tsx,js,jsx}"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "rules": {
    "eslint/curly": ["error", "all"],
    "eslint/sort-keys": "error",
    "eslint/sort-vars": "error",
    "oxlint-plugins/no-destructuring-in-params": "error",
    "oxlint-plugins/no-inline-functions-objects-arrays": "error",
    "oxlint-plugins/no-jsx-inline-computation": "error"
  },
  "plugins": ["eslint", "import", "oxc", "react", "react-perf", "typescript", "unicorn"]
}

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
# Set to 1 when the server runs behind a reverse proxy: the client address is
# then read from the x-forwarded-for header, and the rate limit of the address
# holds. Without it, every client of the proxy shares the address of the proxy.
TRUST_PROXY=0

# The Supabase project of the client.
#
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are read by the Supabase client
# (apps/client/src/shared/auth/supabase/env.ts). The anon key is public by
# design: it only allows the operations the Row Level Security policies allow.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# The base URL of the game server.
#
# It is required: in a production build the client refuses to start without
# it, because the fallback points at a developer machine
# (http://localhost:3001). In development it may be left out and the fallback
# is used.
VITE_API_BASE_URL=http://localhost:3001

# The client uses the PKCE flow (flowType: 'pkce'), so the link of the
# confirmation e-mail and the link of the password recovery come back as
# `?code=` instead of `#access_token=`. The `?code=` is exchanged for a session
# by the Supabase client on the first load of the page.
#
# The redirect of these links is the origin of the client plus the route of
# the destination after the authentication (`/trainers`). That URL has to be
# in the redirect list of the Supabase project:
# Authentication -> URL Configuration -> Redirect URLs.

{
  "name": "creatures",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --filter @creatures/server dev",
    "dev:client": "bun --filter @creatures/client dev",
    "build": "bun --filter '*' build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {},
  "devDependencies": {
    "@rhberro/oxsome": "file:../../oxsome",
    "@types/bun": "^1.4.2",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun lint:fix && bun format"
  }
}

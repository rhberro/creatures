{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "restriction": "error",
    // "style": "error",
    "suspicious": "error"
  },
  "globals": {
    "document": "readonly"
  },
  "ignorePatterns": ["*.d.ts"],
  "jsPlugins": [
    {
      "name": "oxsome",
      "specifier": "@rhberro/oxsome/plugin"
    }
  ],
  "overrides": [
    {
      "files": ["**/*.{ts,tsx,jsx}"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/jsx-filename-extension": "off",
        "react/jsx-no-literals": "off"
      }
    },
    {
      "files": ["**/*.{ts,tsx,js,jsx}"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "rules": {
    "eslint/curly": ["error", "all"],
    "eslint/func-style": ["error", "declaration"],
    "eslint/sort-keys": "error",
    "eslint/sort-vars": "error",
    "oxsome/no-arrow-functions": "error",
    "oxsome/no-destructuring-in-params": "error",
    "oxsome/no-inline-functions-objects-arrays": "error",
    "oxsome/no-jsx-inline-computation": "error"
  },
  "plugins": ["eslint", "import", "oxc", "react", "react-perf", "typescript", "unicorn"]
}
